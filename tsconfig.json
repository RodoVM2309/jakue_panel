{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "baseUrl": "src",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es5",
    "types": ["node"],
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "skipLibCheck": true,
    "paths": {
      "@app/*": ["app/*"],
      "@shared/*": ["app/shared/*"],
      "@components/*": ["app/shared/components/*"],
      "@directives/*": ["app/shared/directives/*"],
      "@helpers/*": ["app/shared/helpers/*"],
      "@pipes/*": ["app/shared/pipes/*"],
      "@muvin/models": ["app/shared/models/index.ts"],
      "@models": ["app/shared/models/index.ts"],
      "@muvin/services": ["app/shared/services/index.ts"],
      "@validation/*": ["app/shared/validation/*"],
      "@home/*": ["app/shared/components/home/*"],
      "@cupo/*": ["app/shared/components/cupo/*"],
      "@views/*": ["app/views/*"],
      "@environments/*": ["src/environments/*"]
    }
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": false,
    "strictInputAccessModifiers": false,
    "strictTemplates": false,
    "resolveJsonModule": true,
 }
}
